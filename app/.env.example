# Required — OpenRouter API key (server only, never exposed to the browser)
OPENROUTER_API_KEY=your_api_key_here
# Required — default OpenRouter model for all LLM steps.
# Must support image input, reasoning, structured outputs and tools.
LLM_MODEL=openai/gpt-6-luna

# Optional — override for image analysis (must support image input)
# VISION_MODEL=
# Optional — override for decision + chat (must support reasoning, structured outputs, tools)
# DECISION_MODEL=

# Optional — directory with return-policy.md and complaint-policy.md (relative to app/)
# POLICIES_DIR=../docs/policies
# Optional — idle expiry of in-memory cases, in minutes
# CASE_TTL_MINUTES=120
